class Solution {
    public int sumOfUnique(int[] nums) {

        Map<Integer, Integer> freq = new HashMap<>();

        for (int i = 0; i < nums.length; i++) {
            int num = nums[i];
            freq.put(num, freq.getOrDefault (num, 0) + 1);
        }

        int sum = 0;
        for (int i = 0; i < nums.length; i++){
            if (freq.get(nums[i]) == 1) { // return the value that store on the map
                sum += nums[i];
            }
        }
        return sum;
    }
}

