class Solution {
    public int[] sortArrayByParity(int[] nums) {

    //using two pointer one from beginning another one from end of array 
    // swap once one is even and another is odd 

	int i = 0;
	int j = nums.length - 1;

	while (i < j) {
	    while (i < j && nums[i] % 2 == 0)
	    i++;
	    while (i < j && nums[j] % 2 == 1)
	    j--;

	    temp = nums[i];
	    nums[i] = nums[j];
	    nums[j] = temp;
	}

	return nums;
    }

}
